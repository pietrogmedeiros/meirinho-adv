# Copie para .env e ajuste. Tudo tem padrão que funciona sem credencial
# externa: sem definir nada, o pipeline roda em modo mock de ponta a ponta.

# Obrigatório trocar antes de qualquer ambiente que não seja a sua máquina.
JWT_SECRET=troque-este-segredo-em-producao

LOG_LEVEL=info

# Análise e classificação. ANALYZER=claude exige ANTHROPIC_API_KEY; sem chave
# o serviço avisa no log e continua no mock em vez de morrer.
ANALYZER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Transcrição. whisper exige o binário instalado na imagem.
TRANSCRIBER=mock

# Monitoramento de processos.
PROCESS_PROVIDER=mock
POLL_INTERVAL=5m
# Chance de o mock gerar andamento por consulta (1 = sempre, para demonstrar o fluxo).
MOCK_MOVEMENT_CHANCE=0.35

# Regra conservadora do classificador: abaixo desta confiança a urgência é
# elevada ao piso e a movimentação é marcada como fallback.
CLASSIFY_PISO=media
CLASSIFY_MIN_CONFIANCA=0.6

# Notificação. Abaixo desta urgência não gera alerta — exceto fallback.
NOTIFY_URGENCIA_MINIMA=baixa
NOTIFY_EMAIL_ENABLED=false
NOTIFY_WHATSAPP_ENABLED=false

MINIO_ROOT_USER=meirinho
MINIO_ROOT_PASSWORD=meirinho123
